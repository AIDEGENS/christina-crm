# .env.example — canonical inventory of all environment variables.
#
# LOCAL DEV:   copy to `.env` and fill in real values. `.env` is gitignored.
# PRODUCTION:  every key below (except the LOCAL-ONLY block) lives in AWS SSM
#              under `/medical-crm/${env}/${KEY}` as a SecureString, KMS-
#              encrypted with `alias/medical-crm`. The container fetches via
#              its ECS task role at boot — see packages/config/src/secrets.ts
#              and docs/SECRETS.md.

# ---------------------------------------------------------------------------
# IDENTITY (git-flow / AI channel) — LOCAL-ONLY, never in SSM
# ---------------------------------------------------------------------------
# Which Claude identity is running in this clone. One of: stone, ikeem, landon
# The git-flow skill reads this to sign channel handoffs.
AI_CHANNEL_IDENTITY=

# ---------------------------------------------------------------------------
# APP — LOCAL-ONLY, never in SSM (runtime defaults set by ECS task def)
# ---------------------------------------------------------------------------
# Runtime environment label: development | staging | production
NODE_ENV=development

# Target SSM env — dev | stg | prd. Injected by the ECS task def in
# staging/prod; locally defaults to dev but unused because bootstrap is a
# no-op outside production.
APP_ENV=dev

# Port for crm-api (Hono server). Default: 3001
PORT=3001

# ---------------------------------------------------------------------------
# APP — replicated to SSM
# ---------------------------------------------------------------------------
# Log level for pino: trace | debug | info | warn | error
LOG_LEVEL=info

# Git SHA injected at build time (e.g. from $GITHUB_SHA). Used in X-Ray
# traces (`version` annotation) and log metadata.
GIT_SHA=REPLACE_ME

# CloudWatch EMF metric namespace (packages/observability/src/metrics.ts)
CW_METRIC_NAMESPACE=christina-crm

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
# Region the app deploys into. Used by the SSM client and the AWS SDK at large.
AWS_REGION=us-west-1

# S3 bucket name for document storage (created in 0.2-aws-infra)
# Pattern: medical-crm-docs-<env>-<region>
S3_BUCKET=medical-crm-docs-dev-us-west-1

# KMS key ARN for S3 + RDS encryption (created in 0.2-aws-infra)
KMS_KEY_ID=REPLACE_ME

# AWS account ID — used in bootstrap-state.sh, GH Actions OIDC role ARN,
# and Terraform. Public component, not sensitive.
AWS_ACCOUNT_ID=REPLACE_ME

# Terraform remote state bucket (created by infra/scripts/bootstrap-state.sh)
TF_STATE_BUCKET=REPLACE_ME
TF_LOCK_TABLE=REPLACE_ME

# X-Ray daemon / ADOT collector sidecar address. ECS task def normally
# leaves the default; override only for container-local testing.
AWS_XRAY_DAEMON_ADDRESS=127.0.0.1:2000

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Postgres connection string. Source: RDS instance in 0.2/0.3 setup.
# Format: postgresql://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=REPLACE_ME

# Optional read replica for analytics / heavy queries
DATABASE_URL_READONLY=REPLACE_ME

# ---------------------------------------------------------------------------
# WORKOS (authentication)
# ---------------------------------------------------------------------------
# Source: WorkOS dashboard -> API Keys
# Starts with "sk_" (live) or "sk_test_" (sandbox)
WORKOS_API_KEY=REPLACE_ME

# Source: WorkOS dashboard -> Configuration -> Client ID
# Starts with "client_"
WORKOS_CLIENT_ID=REPLACE_ME

# Callback URL registered in WorkOS dashboard.
# Local: http://localhost:3000/auth/callback
# Prod:  https://<domain>/auth/callback  (CloudFront-fronted)
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Cookie signing + encryption key. MUST be 32+ characters.
# Generate: openssl rand -hex 32
#
# For rotation, prefer WORKOS_COOKIE_PASSWORD_KEYRING (below) — iron-session
# v8 supports version-mapped keys natively: seal uses the highest-numbered
# key, unseal tries all. Rotation procedure:
#   1. Add the new version to the keyring JSON and deploy.
#   2. All new cookies are sealed with the new version; old cookies still
#      decode because their version is still in the keyring.
#   3. After 7 days (longer than max cookie lifetime), remove the old version.
WORKOS_COOKIE_PASSWORD=REPLACE_ME

# Keyring form (optional, preferred in staging/prod for rotation).
# JSON object: { "<version>": "<password>", ... }. Every value must be 32+ chars.
# If set, WORKOS_COOKIE_PASSWORD is ignored.
# Example: WORKOS_COOKIE_PASSWORD_KEYRING={"1":"aaaa...(32+)","2":"bbbb...(32+)"}
WORKOS_COOKIE_PASSWORD_KEYRING=

# WorkOS JWT issuer. The API verifies access-token signatures against the
# WorkOS JWKS at ${WORKOS_ISSUER}/.well-known/jwks.json and enforces the `iss`
# + `aud` claims (aud = WORKOS_CLIENT_ID). Typical value: https://api.workos.com
WORKOS_ISSUER=https://api.workos.com

# Webhook secret for verifying WorkOS SCIM/directory sync events.
# Source: WorkOS dashboard -> Webhooks -> Endpoint secret
WORKOS_WEBHOOK_SECRET=REPLACE_ME

# Comma-separated list of origins allowed to hit /v1/* (CSRF gate).
# Every request must carry an Origin or Referer header whose origin is in
# this list, or it is rejected with 403. No wildcards. MUST be set — an
# empty allowlist fails closed.
# Local dev: http://localhost:3000
# Prod: https://crm.example.com (or whatever your web origin is)
ALLOWED_ORIGINS=http://localhost:3000

# Public — safe in browser bundle. "sandbox" until you go live.
NEXT_PUBLIC_WORKOS_ENV=sandbox

# WorkOS redirect URI exposed to the Next.js client (same value as WORKOS_REDIRECT_URI)
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# App URL exposed to Next.js client
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public env label for the browser bundle
NEXT_PUBLIC_ENV=dev

# Public git SHA for the browser bundle
NEXT_PUBLIC_GIT_SHA=REPLACE_ME

# ---------------------------------------------------------------------------
# CI / TURBO REMOTE CACHE — GitHub Actions secrets, NOT in SSM
# ---------------------------------------------------------------------------
# Turborepo remote cache token
TURBO_TOKEN=REPLACE_ME

# Turborepo team slug
TURBO_TEAM=REPLACE_ME

# ---------------------------------------------------------------------------
# DEV ONLY (remove after Phase 0.3 RLS is wired) — LOCAL-ONLY, never in SSM
# ---------------------------------------------------------------------------
# Bypass tenant lookup in local dev. Replace with a real seeded tenant UUID
# from packages/db/src/seed.ts output. The zero-UUID sentinel below is safe
# for a fresh clone but will fail any real DB call — swap it out before
# testing flows that hit the database.
# The API throws `DEV_SHIM_IN_PROD` at module load if NODE_ENV=production
# and either of these is set. Do NOT populate these in SSM for stg/prd.
DEV_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
DEV_AUTH_ROLE=admin
