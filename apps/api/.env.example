# apps/api/.env.example — Phase 0.4 WorkOS auth
#
# Copy to apps/api/.env and fill in. Never commit .env.
# In production, values come from AWS SSM under /medical-crm/${env}/${KEY}
# — see docs/SECRETS.md.

# Hono listens on this port (dev).
PORT=3001

# Target SSM env when NODE_ENV=production. dev | stg | prd.
APP_ENV=dev

# --- WorkOS ---
# Same values the web app uses. API reads the session cookie the web sets.
WORKOS_API_KEY=REPLACE_ME
WORKOS_CLIENT_ID=REPLACE_ME
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_COOKIE_PASSWORD=REPLACE_ME_MIN_32_CHARS_REQUIRED

# --- WorkOS webhooks (directory sync, post-MVP) ---
# From WorkOS dashboard -> Webhooks -> your endpoint -> Signing secret.
# Leave unset in MVP to have /webhooks/workos-scim return 503.
WORKOS_WEBHOOK_SECRET=REPLACE_ME

# --- Dev-only tenant shim ---
# See packages/auth/src/tenant.ts. Remove after Phase 0.3.
DEV_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000001
DEV_AUTH_ROLE=admin

# --- X-Ray (AWS-only migration) ---
# ADOT sidecar UDP address. Leave default in container. Only set locally
# to point at a dev X-Ray daemon.
AWS_XRAY_DAEMON_ADDRESS=127.0.0.1:2000
# Service name used as the X-Ray segment name and pino base field.
SERVICE_NAME=crm-api
# Git SHA for version-pinning traces. GitHub Actions sets $GITHUB_SHA.
GIT_SHA=dev
# Pino log level: trace|debug|info|warn|error|fatal.
LOG_LEVEL=info
