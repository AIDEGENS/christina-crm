# apps/web/.env.example — Phase 0.4 WorkOS auth
#
# Copy to apps/web/.env.local and fill in. Never commit .env.local.
# In production, values come from AWS SSM under /medical-crm/${env}/${KEY}
# — see docs/SECRETS.md. This file is dev-only.

# --- WorkOS ---
# From WorkOS dashboard -> API Keys. Sandbox org for local dev.
WORKOS_API_KEY=REPLACE_ME
# From WorkOS dashboard -> Configuration -> Client ID.
WORKOS_CLIENT_ID=REPLACE_ME
# Where WorkOS redirects after successful sign-in. Must match the value
# registered in the WorkOS dashboard -> Redirects.
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# Cookie signing + encryption password. MIN 32 chars.
# Generate with: openssl rand -hex 32
WORKOS_COOKIE_PASSWORD=REPLACE_ME_MIN_32_CHARS_REQUIRED

# Public env (ok to ship to the browser). Controls which WorkOS environment
# label shows in dev UI.
NEXT_PUBLIC_WORKOS_ENV=sandbox

# --- Dev-only tenant shim ---
# Used by packages/auth/src/tenant.ts until Phase 0.3 wires the real DB
# lookup. DELETE these from your .env once tenant_members table is live.
DEV_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000001
DEV_AUTH_ROLE=admin

# --- Build metadata (AWS-only migration) ---
# Environment label shown in the browser bundle. `development` | `preview` | `production`.
NEXT_PUBLIC_ENV=development
# Git SHA of the running build. GitHub Actions sets $GITHUB_SHA at build.
NEXT_PUBLIC_GIT_SHA=dev
# Frontend RUM is deferred — CloudWatch RUM wires at pilot signing. No
# NEXT_PUBLIC_DD_RUM_* vars are needed anymore.
